# Replace this value before starting AnyCode.
ANYCODE_ACCESS_KEY=replace-with-a-long-random-secret

# Listen on loopback by default. Use a trusted TLS reverse proxy for remote access.
ANYCODE_HTTP_ADDR=127.0.0.1:8080

# The user service reuses this user's HOME and ~/.codex credentials.
# Set an absolute path when codex is outside ~/.local/bin, /usr/local/bin, or /usr/bin.
CODEX_BIN=codex

# Optional: required only when creating Cloudflare quick tunnels.
CLOUDFLARED_BIN=cloudflared

# The unit stores local data in ~/.local/share/anycode by default.
# DATABASE_URL and TURSO_DATABASE_URL can override its local database.
